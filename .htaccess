

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ── short link for Fact Garden ───────────────────────────────
# factgarden.data542.com shares this document root (set up in cPanel
# Domains) and forwards to the shared page. 302 so the target can change
# later without browsers holding on to it. .well-known stays reachable
# so AutoSSL can issue the subdomain's certificate.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^factgarden\.data542\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://data542.com/factgarden/play/ [R=302,L]
</IfModule>

# ── cache policy ──────────────────────────────────────────────
# HTML/CSS/JS revalidate on every request (cheap: a 304 when unchanged),
# so edits appear immediately. Images cache for a week.
# Both blocks are guarded, so if a module is missing Apache ignores them
# rather than erroring.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType text/css               "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/png              "access plus 1 week"
  ExpiresByType image/svg+xml          "access plus 1 week"
  ExpiresByType image/gif              "access plus 1 week"
</IfModule>
